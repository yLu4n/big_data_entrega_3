{
  "openapi": "3.1.0",
  "info": {
    "title": "Empreendedorismo Feminino na Bahia API de dados",
    "version": "1.0.0",
    "description": "API própria de leitura da base tratada PNAD Contínua. Relê o arquivo em cada requisição. Snapshot completo de ocupados da Bahia, sem paginação. Serviço local, sem autenticação. Novos dados devem ser incorporados ao arquivo de origem."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Verifica se o processo está ativo; não verifica a base",
        "responses": {
          "200": {
            "description": "Processo ativo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "version"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "empreendedorismo-feminino-bahia-api"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/observacoes": {
      "get": {
        "operationId": "listarObservacoes",
        "summary": "Snapshot atualizado da base tratada",
        "description": "Somente 14 variáveis analíticas, sem identificadores domiciliares. Pesos positivos; ausências opcionais são null. Sem cache, paginação ou escrita. Os filtros pertencem ao dashboard.",
        "responses": {
          "200": {
            "description": "Snapshot lido nesta requisição (data pode ser vazio)",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Observacao"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Fonte ausente, inválida ou ilegível; corrigir antes de tentar novamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "SOURCE_UNAVAILABLE",
                    "message": "Não foi possível ler a base tratada. Verifique DATA_FILE ou o pacote original."
                  }
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "Contrato OpenAPI autoritativo",
        "responses": {
          "200": {
            "description": "Este documento",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Observacao": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ano",
          "trimestre",
          "uf",
          "capital",
          "v1028",
          "v2007",
          "v2009",
          "v2010",
          "vd3004",
          "vd4002",
          "vd4009",
          "v4019",
          "vd4010",
          "vd4016"
        ],
        "properties": {
          "ano": {
            "type": "number"
          },
          "trimestre": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "uf": {
            "type": "number",
            "const": 29
          },
          "capital": {
            "type": [
              "number",
              "null"
            ]
          },
          "v1028": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "v2007": {
            "type": "number"
          },
          "v2009": {
            "type": "number"
          },
          "v2010": {
            "type": "number"
          },
          "vd3004": {
            "type": "number"
          },
          "vd4002": {
            "type": "number",
            "const": 1
          },
          "vd4009": {
            "type": "number"
          },
          "v4019": {
            "type": [
              "number",
              "null"
            ]
          },
          "vd4010": {
            "type": "number"
          },
          "vd4016": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "Metadata": {
        "type": "object",
        "required": [
          "total",
          "consultado_em",
          "versao",
          "fonte"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time",
            "description": "Hora UTC da leitura; não é a data de divulgação do IBGE."
          },
          "versao": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 dos bytes do CSV lido."
          },
          "fonte": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
